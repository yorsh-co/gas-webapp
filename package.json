{
  "name": "gas-webapp",
  "version": "0.0.0",
  "private": true,
  "description": "Single-entry-point router and middleware for Google Apps Script web apps.",
  "repository": {
    "type": "git",
    "url": "https://github.com/yorsh-co/gas-webapp.git"
  },
  "author": "Joshua Porter",
  "license": "MIT",
  "yorsh": {
    "organization": "Yorsh",
    "homepage": "https://yorsh.co"
  },
  "engines": {
    "node": ">=20.0.0"
  },
  "type": "module",
  "prettier": {
    "singleQuote": true
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@types/google-apps-script": "^2.0.11",
    "eslint": "^10.7.0",
    "eslint-config-prettier": "^10.1.8",
    "globals": "^17.7.0",
    "prettier": "^3.9.6",
    "rimraf": "^6.1.3",
    "typescript": "^5.9.3",
    "typescript-eslint": "^8.65.0"
  },
  "scripts": {
    "clean": "rimraf dist",
    "release": "bash scripts/release.sh",
    "build": "npm run clean && npm run build:backend && npm run build:frontend",
    "build:format": "npm run check && npm run build && npm run format:dist",
    "build:backend": "tsc -p tsconfig.json",
    "build:frontend": "tsc -p tsconfig.frontend.json",
    "build:watch": "tsc --watch",
    "build:release": "npm run build:format && npm run release",
    "typecheck": "npm run typecheck:backend && npm run typecheck:frontend",
    "typecheck:backend": "tsc -p tsconfig.json --noEmit && echo '✓ TypeScript passed (backend)'",
    "typecheck:frontend": "tsc -p tsconfig.frontend.json --noEmit && echo '✓ TypeScript passed (frontend)'",
    "lint": "eslint . && echo '✓ Lint passed'",
    "lint:fix": "eslint . --fix",
    "format": "prettier . --write",
    "format:dist": "prettier ./dist --write --ignore-path .prettierignore",
    "format:check": "prettier . --check",
    "check": "npm run format:check && npm run lint && npm run typecheck"
  }
}
