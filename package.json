{
  "name": "gas-webapp",
  "version": "1.0.4",
  "private": true,
  "description": "Express-style router and middleware for Google Apps Script web apps.",
  "repository": {
    "type": "git",
    "url": "https://github.com/yorsh-co/gas-webapp.git"
  },
  "author": "Joshua Porter",
  "license": "MIT",
  "yorsh": {
    "organization": "Yorsh",
    "homepage": "https://yorsh.co"
  },
  "engines": {
    "node": "^22.13.0 || ^24.0.0 || >=26.0.0"
  },
  "type": "module",
  "prettier": "gas-dev-config/prettier",
  "devDependencies": {
    "@google/clasp": "^3.4.1",
    "@types/google-apps-script": "^2.0.14",
    "@types/node": "^26.6.6",
    "eslint": "^10.14.0",
    "gas-dev-bundle": "github:yorsh-co/gas-dev-bundle#semver:^2.0.0",
    "gas-dev-config": "github:yorsh-co/gas-dev-config#semver:^2.0.0",
    "gas-dev-release": "github:yorsh-co/gas-dev-release#semver:^2.0.0",
    "prettier": "^3.9.10",
    "rimraf": "^6.1.3",
    "typescript": "^7.0.2",
    "vitest": "^5.0.3"
  },
  "overrides": {
    "minimatch": "^11.0.1",
    "gaxios": "^7.3.1"
  },
  "scripts": {
    "clean": "rimraf dist",
    "release": "gas-dev-release",
    "build": "npm run clean && npm run build:backend && npm run build:frontend",
    "build:format": "npm run check && npm run build && npm run format:dist",
    "build:backend": "tsc -p tsconfig.json",
    "build:frontend": "tsc -p tsconfig.frontend.json",
    "build:watch": "trap \"trap - INT TERM; kill 0\" INT TERM; tsc -p tsconfig.json --watch --preserveWatchOutput & tsc -p tsconfig.frontend.json --watch --preserveWatchOutput & wait",
    "build:release": "npm run build:format && npm run release",
    "typecheck": "npm run typecheck:backend && npm run typecheck:frontend && npm run typecheck:test && npm run typecheck:peer && npm run typecheck:gas-test",
    "typecheck:backend": "tsc -p tsconfig.json --noEmit && echo \"✓ TypeScript passed (backend)\"",
    "typecheck:frontend": "tsc -p tsconfig.frontend.json --noEmit && echo \"✓ TypeScript passed (frontend)\"",
    "typecheck:test": "tsc -p tsconfig.test.json && echo \"✓ TypeScript passed (test)\"",
    "typecheck:peer": "tsc -p tsconfig.peer.json && echo \"✓ TypeScript passed (peer)\"",
    "lint": "eslint . && echo '✓ Lint passed'",
    "lint:fix": "eslint . --fix",
    "format": "prettier . --write",
    "format:dist": "prettier ./dist --write --ignore-path .prettierignore",
    "format:check": "prettier . --check",
    "check": "npm run format:check && npm run lint && npm run typecheck && npm run test && gas-dev-config check",
    "peers:sync": "gas-dev-config peers sync",
    "peers:check": "gas-dev-config peers sync --check",
    "test": "vitest run",
    "test:watch": "vitest",
    "typecheck:gas-test": "tsc -p gas-test/tsconfig.json --noEmit && echo \"✓ TypeScript passed (gas-test)\"",
    "test:gas:build": "gas-dev-config gas-test build",
    "test:gas": "gas-dev-config gas-test run",
    "manual:build": "npm run build && node scripts/build-manual-webapp.js"
  },
  "gasDevConfig": {
    "loadOrder": [
      "gas-webapp.response.ts",
      "gas-webapp.router.class.ts",
      "gas-webapp.constants.ts",
      "gas-webapp.class.ts",
      "middleware/gas-webapp.ack.ts",
      "middleware/gas-webapp.auth.ts",
      "middleware/gas-webapp.limiter.ts",
      "middleware/gas-webapp.idempotency.ts",
      "middleware/gas-webapp.logging.ts"
    ],
    "peers": {
      "gas-error": "^1.2.0",
      "gas-logger": "^1.3.0 || ^2.0.0",
      "gas-lock": "^1.2.0"
    },
    "gasTest": {
      "scopes": [
        "https://www.googleapis.com/auth/userinfo.email"
      ]
    }
  },
  "gasDevRelease": {
    "targets": [
      {
        "branch": "dist",
        "hide": [
          "**/types/*.js",
          "shared/*.js"
        ],
        "exclude": [
          "web/",
          "internal/"
        ]
      },
      {
        "branch": "dist-web",
        "from": "dist/web",
        "hide": [
          "**/types/*.js",
          "gas-webapp.client.d.ts",
          "gas-webapp.config.d.ts",
          "gas-webapp.errors.d.ts"
        ],
        "include": [
          {
            "from": "dist/shared",
            "to": "shared",
            "hide": [
              "*.js"
            ]
          }
        ],
        "files": [
          "src/web/README.md:README.md",
          "LICENSE.md",
          "CHANGELOG.md"
        ],
        "packageJson": false
      }
    ],
    "githubRelease": true
  }
}
